AI_FITNESS_APP_NAME=AI Fitness Coach API
AI_FITNESS_ENVIRONMENT=development
AI_FITNESS_DEBUG=true
AI_FITNESS_DATABASE_URL=sqlite:///./ai_fitness_coach.db
AI_FITNESS_CORS_ORIGINS=http://localhost:3000
AI_FITNESS_LOG_LEVEL=INFO
# Reserved for the future authentication module. Replace before production.
AI_FITNESS_JWT_SECRET_KEY=change-this-to-a-long-random-secret
AI_FITNESS_JWT_ALGORITHM=HS256
AI_FITNESS_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
AI_FITNESS_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
